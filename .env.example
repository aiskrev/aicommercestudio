# =============================================================================
# A.I. Commerce Studio — environment configuration (EXAMPLE / TEMPLATE)
# Copy to .env (scripts\setup.ps1 does this and generates random secrets).
# Never commit .env. Never put real production secrets in this file.
# =============================================================================

# --- General ---------------------------------------------------------------
# development | production   (test is used automatically by the test suite)
APP_ENV=development
LOG_LEVEL=INFO

# Public URL of the website (used for canonical URLs, sitemap, Open Graph).
# Baked into the web build — rebuild the web image after changing it.
SITE_URL=http://localhost:3000

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=acs
POSTGRES_USER=acs
# Generated by scripts\setup.ps1. Use only [A-Za-z0-9] characters.
POSTGRES_PASSWORD=change-me-generated-by-setup
# Host port for local DB access (127.0.0.1 only). 5433 avoids clashing with a local Postgres.
POSTGRES_HOST_PORT=5433

# --- API security ----------------------------------------------------------------
# At least 32 random characters. Generated by scripts\setup.ps1.
SECRET_KEY=change-me-generated-by-setup-at-least-32-characters
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false for http://localhost. Production forces secure cookies.
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
# Revoke sessions after this many minutes without activity
SESSION_IDLE_MINUTES=60
# Trust X-Forwarded-For from the Next.js proxy / reverse proxy (needed for per-IP rate limits).
TRUST_PROXY_HEADERS=true
# Expose Swagger UI at http://localhost:8000/api/docs (disabled by default in production)
ENABLE_API_DOCS=true

# --- Spam protection & rate limiting ------------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600
# Backstop across all clients per window
CONTACT_GLOBAL_RATE_LIMIT=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
# Persistent account lockout after N consecutive failed logins (survives restarts)
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
FORM_TOKEN_MIN_SECONDS=3
FORM_TOKEN_MAX_AGE_SECONDS=7200

# --- GDPR / retention -----------------------------------------------------------------
# Leads untouched for this many days are deleted by `python -m app.cli maintenance`.
LEAD_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1095
PRIVACY_NOTICE_VERSION=2026-10-draft
# Wording version of the optional marketing consent; stored with every consent that is given.
MARKETING_CONSENT_VERSION=2026-10-v1
# AI readiness submissions (source readiness_assessment) are deleted after this many days
# (or LEAD_RETENTION_DAYS if shorter). Anonymous PDF reports are never stored.
READINESS_RETENTION_DAYS=365
# Anonymous readiness PDF reports per client / for all clients, per window (CPU-bound rendering).
READINESS_REPORT_RATE_LIMIT=10
READINESS_REPORT_GLOBAL_RATE_LIMIT=300
READINESS_REPORT_RATE_WINDOW_SECONDS=600
# AI team configurator. Optional alternative cost assumptions (default app/team/pricing/2026-10.1.json).
# TEAM_COST_ASSUMPTIONS_FILE=/app/app/team/pricing/2026-10.1.json
# Saved configurations without a consultation are deleted after this many days.
TEAM_CONFIGURATION_RETENTION_DAYS=90
# Consultation leads from the configurator (or LEAD_RETENTION_DAYS if shorter).
TEAM_LEAD_RETENTION_DAYS=365
TEAM_ESTIMATE_RATE_LIMIT=60
TEAM_REPORT_RATE_LIMIT=10
TEAM_SAVE_RATE_LIMIT=10
TEAM_LOOKUP_RATE_LIMIT=30
TEAM_GLOBAL_RATE_LIMIT=600
TEAM_RATE_WINDOW_SECONDS=600

# Assessment engine (app/assessments). Saved results (opt-in, no personal data) expire after this many days.
ASSESSMENT_RETENTION_DAYS=90
ASSESSMENT_RATE_LIMIT=30
ASSESSMENT_SAVE_RATE_LIMIT=10
ASSESSMENT_LOOKUP_RATE_LIMIT=30
ASSESSMENT_REPORT_RATE_LIMIT=10
ASSESSMENT_GLOBAL_RATE_LIMIT=600
ASSESSMENT_RATE_WINDOW_SECONDS=600
# Serve definitions with status "preview" (staging, tests). Keep false in production.
ASSESSMENTS_PREVIEW_ENABLED=false

# --- Initial administrator (used by `python -m app.cli seed`) -------------------------------
# Development only. Password is generated by scripts\setup.ps1 (min. 12 characters).
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Администратор
# Seed synthetic (clearly fake) demo leads on startup in development
SEED_SAMPLE_DATA=true

# --- AI provider ------------------------------------------------------------------------------
# mock (default, no key, no network) | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Per-request timeout (seconds) for admin lead triage
ANTHROPIC_TIMEOUT_SECONDS=30

# --- AI Business Automation Advisor (/ai-automation-advisor) -----------------------------------
# Works without an API key (demo mode, clearly labelled). Limits protect AI provider spend.
ADVISOR_RATE_LIMIT=5
ADVISOR_RATE_WINDOW_SECONDS=3600
ADVISOR_GLOBAL_RATE_LIMIT=120
# Per attempt; at most one retry. The web proxy waits up to 100 s for advisor requests.
ADVISOR_TIMEOUT_SECONDS=45
# Unlinked assessments are deleted after this many days; linked ones follow the lead.
ADVISOR_RETENTION_DAYS=30

# --- Email (optional) — leave SMTP_HOST empty to disable sending ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
LEAD_NOTIFICATION_EMAIL=

# --- Future integrations (status only in V1; nothing is called) --------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
CRM_PROVIDER=
AUTOMATION_WEBHOOK_URL=
SEO_DATA_PROVIDER=

# --- Public contact details (empty = the approved values in apps/web/src/lib/company.ts) ---------
# Changing the domain also moves the e-mail (contact@<domain>) unless PUBLIC_CONTACT_EMAIL is set.
PUBLIC_CONTACT_DOMAIN=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=

# --- Service catalogue pages (website) ---------------------------------------------------------
# Secret for POST /api/catalogue-revalidate (header X-Revalidate-Secret), which regenerates the
# catalogue pages at once after publishing. Empty = endpoint disabled; pages refresh every 300 s.
# At least 16 characters. scripts/test.ps1 generates one per e2e run when it is not set.
CATALOGUE_REVALIDATE_SECRET=
