[Unit]
Description=A.I. Commerce Studio transactional e-mail retries
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-commerce-studio
ExecStart=/bin/sh -c 'docker compose --project-directory /opt/ai-commerce-studio --env-file /opt/ai-commerce-studio/.env --env-file /opt/ai-commerce-studio/release.env -f /opt/ai-commerce-studio/compose.yml exec -T api python -m app.cli outbox-run'
