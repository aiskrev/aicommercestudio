# Template for /opt/ai-commerce-studio/.env (root:root, chmod 600). Never commit the real file.
# Generate secrets on the server, never reuse development values:
#   SECRET_KEY, CATALOGUE_REVALIDATE_SECRET: openssl rand -hex 32
#   POSTGRES_PASSWORD:                       openssl rand -hex 24
# APP_ENV, ENABLE_API_DOCS, SEED_SAMPLE_DATA and RUN_MIGRATIONS_ON_START are fixed in compose.yml.

SITE_URL=https://ai-commercestudio.com
CORS_ORIGINS=https://ai-commercestudio.com
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
LOG_LEVEL=INFO

POSTGRES_DB=acs
POSTGRES_USER=acs
POSTGRES_PASSWORD=change-me-on-the-server
SECRET_KEY=change-me-on-the-server
CATALOGUE_REVALIDATE_SECRET=change-me-on-the-server


# Real AI use needs the owner's explicit authorisation.
AI_PROVIDER=mock

# Staff sign-in requires TOTP once at least one administrator has enrolled.
ADMIN_MFA_REQUIRED=true

# Restricted API login (H-1). Empty: the API keeps connecting as the owner. See infra/deploy/README.md.
# API_DB_USER=acs_app_api
# API_DB_PASSWORD=                         openssl rand -hex 24

# Site statistics (docs/ANALYTICS.md): anonymous and cookieless. Switch on only after the privacy notice
# describes them; the dashboard is under /admin/analytics.
ANALYTICS_ENABLED=false

# Commercial features (docs/COMMERCIAL_STAGING_RUNBOOK.md): both the API and the web app read these names, so set them
# here and nowhere else. The quote basket and the configurator need no accounts and no e-mail (the cookie policy describes
# their browser storage since 2026-11-13, BLOCKER-COM-STORAGE-01 closed). Quotations stay off until
# BLOCKER-COM-ACCEPT-01 is closed; projects, documents and uploads need customer accounts and have their own gates.
PROJECT_CONFIGURATOR_ENABLED=false
QUOTE_BASKET_ENABLED=false
QUOTATIONS_ENABLED=false
COMMERCIAL_PROJECTS_ENABLED=false

# Customer accounts stay off until a release review. Turning them on without a configured
# provider stops the API from starting: nothing pretends to send e-mail.
CUSTOMER_ACCOUNTS_ENABLED=false
EMAIL_PROVIDER=disabled
# Leave empty until the mailbox and SMTP have been tested end to end.
SMTP_HOST=
LEAD_NOTIFICATION_EMAIL=
