    "en": {
      "title": "FinOps & AI Cost Assessment",
      "intro": "11 questions across 5 areas: visibility, budgets, optimisation, AI model costs and accountability. It contains no savings forecasts.",
      "disclaimer": "A self-assessment based on your answers. We do not connect to your systems and scan nothing. The result is not an audit, not legal advice and has not been independently verified.",
      "dimensions": {
        "visibility": {
          "title": "Visibility and allocation",
          "description": "Whether you know who spends how much on what."
        },
        "budgets": {
          "title": "Budgets and forecasting",
          "description": "Budgets, alerts and forecasts."
        },
        "optimisation": {
          "title": "Optimisation",
          "description": "Rightsizing, schedules and commitments."
        },
        "ai_cost": {
          "title": "AI model costs",
          "description": "Tokens, model choice, caching."
        },
        "governance": {
          "title": "Accountability",
          "description": "Who decides and who is accountable for spend."
        }
      },
      "questions": {
        "spend_context": {
          "text": "Where is most of your spend?",
          "help": "Select all that apply. It does not change the score.",
          "options": {
            "aws": "AWS",
            "azure": "Microsoft Azure",
            "gcp": "Google Cloud",
            "ai_apis": "AI APIs (models)",
            "saas": "SaaS subscriptions",
            "hosting": "Hosting or own servers"
          }
        },
        "fo_tags": {
          "text": "Can you allocate spend by product, team or customer?",
          "options": {
            "no": "No",
            "partly": "Partly",
            "mostly": "For most spend",
            "fully": "Yes, with tags or separate accounts"
          }
        },
        "fo_reports": {
          "text": "How often is spend reviewed?",
          "options": {
            "invoice": "When the invoice arrives",
            "monthly": "Monthly",
            "weekly": "Weekly",
            "dashboards": "Continuously, with dashboards"
          }
        },
        "fo_budgets": {
          "text": "Are there budgets with alerts?",
          "options": {
            "no": "No",
            "total": "Only a total budget",
            "per_area": "Per area",
            "alerts": "Per area, with alerts on anomalies"
          }
        },
        "fo_forecast": {
          "text": "Do you forecast spend?",
          "options": {
            "no": "No",
            "rough": "Roughly",
            "model": "With a growth model",
            "unit": "With unit costs (customer, order)"
          }
        },
        "fo_rightsizing": {
          "text": "Do you rightsize resources?",
          "options": {
            "never": "Never",
            "once": "Once",
            "regular": "Regularly",
            "automated": "Automatically"
          }
